# OutboxLab — local dev environment
# Copy to .env (`make env`). Never commit .env.

# ---- Local domain ----
# Real value lives in .env only. Used by the Caddy proxy + Makefile (certs, hosts).
# Pick anything you control, e.g. api.<project>.local or api.<project>.local.<your-domain>
API_DOMAIN=api.example.local

# ---- Database ----
# DATABASE_URL: SQLAlchemy + asyncpg, used inside compose containers (`postgres` resolves via the compose network).
# DATABASE_URL_PSQL: plain libpq URL for host-side tools (psql, IDE) — libpq does not understand the `+asyncpg` dialect tag.
# Postgres is published on 127.0.0.1:55432 to avoid clashing with any other local pg.
# Production: Neon URL goes to fly secrets, NOT here.
DATABASE_URL=postgresql+asyncpg://outboxlab:outboxlab@postgres:5432/outboxlab
DATABASE_URL_PSQL=postgresql://outboxlab:outboxlab@127.0.0.1:55432/outboxlab
POSTGRES_USER=outboxlab
POSTGRES_PASSWORD=outboxlab
POSTGRES_DB=outboxlab

# ---- Google OAuth (Gmail API) ----
# The redirect URI is derived at runtime as `https://${API_DOMAIN}/auth/google/callback`
# — this is intentional, so the URL cannot drift away from API_DOMAIN. Register that
# exact URL (for each env: local mkcert, fly.dev, custom domain) in your GCP OAuth client
# under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token minted once (OAuth Playground / one-off script) with scopes
# gmail.send + gmail.readonly. Access tokens are minted from it at runtime.
GOOGLE_REFRESH_TOKEN=
# The Gmail account the worker polls + sends from (lowercased at seed).
GMAIL_USER_EMAIL=
# Workspace that owns the seeded mailbox. Defaults to the seeded default workspace id.
MAILBOX_WORKSPACE_ID=019e5f2a-1a6d-7fa2-8bee-55d3e1ccdc3d

# ---- LLM (step 2+) ----
# LLM_ENABLED=true uses an LLM intent classifier for real-reply accuracy.
# LLM_PROVIDER picks the backend: "anthropic" or "openai". The classifier
# activates only when the chosen provider's key is also set, and falls back to
# the deterministic classifier on any API error — so a keyless env (CI, bare
# demo) stays fully offline. Set LLM_ENABLED=false to force deterministic.
LLM_ENABLED=true
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- App ----
APP_ENV=local
API_PORT=8000
WEB_PORT=3000

# ---- Worker (Gmail poller) ----
POLL_INTERVAL_SECONDS=15
POLL_JITTER_SECONDS=5

# ---- Demo helpers (Makefile targets, nothing to set here) ----
# make api-key                             print a new workspace API key once (the only way in when APP_ENV=production)
# make smoke-readonly                      read-only checks against the local api container; sends no email
# make smoke SMOKE_LEAD_EMAIL=<address>    full run: real send, reply by hand, the lead must pause
# make demo-reset [CONFIRM=yes]            local only: shows, then deletes, campaigns and messages of MAILBOX_WORKSPACE_ID
# Demo order: make seed, wait until /debug/state shows a sync cursor, then create the campaign.
# The lead must be a separate mailbox; the worker ignores mail sent by the polled mailbox itself.

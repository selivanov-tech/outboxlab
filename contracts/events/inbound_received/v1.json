{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outboxlab/events/inbound_received/v1",
  "title": "InboundReceived",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "workspace_id",
    "mailbox_id",
    "inbound_id",
    "provider_message_id",
    "provider_thread_id",
    "from_email",
    "subject",
    "received_at"
  ],
  "properties": {
    "event_type": { "const": "InboundReceived" },
    "workspace_id": { "type": "string", "format": "uuid" },
    "mailbox_id": { "type": "string", "format": "uuid" },
    "inbound_id": { "type": "string", "format": "uuid" },
    "provider_message_id": { "type": "string" },
    "provider_thread_id": { "type": "string" },
    "from_email": { "type": "string" },
    "subject": { "type": "string" },
    "received_at": { "type": "string", "format": "date-time" }
  }
}

{
  "name": "@outboxlab/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "api:generate": "openapi-typescript ../../contracts/openapi/api-v1.json --output src/shared/api/generated/api-v1.ts",
    "api:check": "pnpm api:generate && git diff --exit-code -- src/shared/api/generated"
  },
  "dependencies": {
    "next": "16.3.4",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
